{
    "name": "client",
    "version": "1.0.0",
    "scripts": {
        "ng": "ng",
        "start": "ng serve --open",
        "build": "ng build",
        "watch": "ng build --watch --configuration development",
        "test": "ng test",
        "deploy": "ng build",
        "format": "prettier --ignore-path ../.prettierignore --write \"src/**/*.{ts,js,css,html,json}\"",
        "coverage": "ng test --code-coverage --source-map=true",
        "lint": "eslint --config eslint.config.mjs \"src/**/*.ts\"",
        "lint:fix": "eslint --config eslint.config.mjs \"src/**/*.ts\" --fix",
        "start-chromium": "BROWSER=chromium ng serve --open"
    },
    "prettier": {
        "printWidth": 150,
        "singleQuote": true,
        "semi": true,
        "tabWidth": 4,
        "trailingComma": "all",
        "overrides": [
            {
                "files": "*.html",
                "options": {
                    "parser": "angular"
                }
            }
        ]
    },
    "private": true,
    "packageManager": "npm@11.9.0",
    "dependencies": {
        "@angular/common": "^21.1.0",
        "@angular/compiler": "^21.1.0",
        "@angular/core": "^21.1.0",
        "@angular/forms": "^21.1.0",
        "@angular/platform-browser": "^21.1.0",
        "@angular/router": "^21.1.0",
        "html2canvas-pro": "^1.6.6",
        "rxjs": "~7.8.0",
        "socket.io-client": "^4.8.3",
        "tslib": "^2.3.0",
        "zone.js": "^0.16.0"
    },
    "devDependencies": {
        "@angular/build": "^21.1.2",
        "@angular/cli": "^21.1.2",
        "@angular/compiler-cli": "^21.1.0",
        "@tailwindcss/postcss": "^4.1.12",
        "@types/jasmine": "^6.0.0",
        "angular-eslint": "21.2.0",
        "autoprefixer": "^10.4.24",
        "eslint": "^9.39.2",
        "jasmine-core": "^6.0.1",
        "jsdom": "^27.1.0",
        "karma": "^6.4.4",
        "karma-chrome-launcher": "^3.2.0",
        "karma-coverage": "^2.2.1",
        "karma-jasmine": "^5.1.0",
        "karma-jasmine-html-reporter": "^2.2.0",
        "postcss": "^8.5.3",
        "tailwindcss": "^4.1.12",
        "typescript": "~5.9.2",
        "typescript-eslint": "8.50.1"
    }
}
