{
    "name": "server",
    "version": "1.0.0",
    "scripts": {
        "start": "nodemon",
        "build": "rimraf out && tsc --project tsconfig.app.json",
        "format": "prettier --config ../.prettierrc.yaml --write \"app/**/*\"",
        "lint": "eslint --config eslint.config.mjs \"./app/**/*.ts\"",
        "lint:fix": "eslint --config eslint.config.mjs \"./app/**/*.ts\" --fix",
        "test": "cross-env TS_NODE_PROJECT='./tsconfig.spec.json' mocha --config=.mocharc.json --node-env=test",
        "coverage": "cross-env TS_NODE_PROJECT='./tsconfig.spec.json' nyc mocha --config=.mocharc.json --node-env=test --exit",
        "clean": "rm -rf .nyc_output coverage node_modules out/common out/server package-lock.json"
    },
    "nyc": {
        "per-file": true,
        "include": [
            "app/**/*.ts"
        ],
        "extension": [
            ".ts"
        ],
        "exclude": [
            "**/*.spec.ts",
            "app/index.ts",
            "app/server.ts",
            "app/app.ts"
        ],
        "require": [
            "ts-node/register",
            "tsconfig-paths/register"
        ],
        "reporter": [
            "html",
            "text"
        ],
        "all": true,
        "cache": true,
        "sourceMap": true,
        "instrument": true
    },
    "_moduleAliases": {
        "@app": "out/server/app",
        "@common": "out/common"
    },
    "private": true,
    "packageManager": "npm@11.9.0",
    "dependencies": {
        "cookie-parser": "1.4.7",
        "cors": "2.8.6",
        "dotenv": "^17.4.1",
        "express": "5.2.1",
        "http-status-codes": "2.3.0",
        "module-alias": "2.3.4",
        "mongodb": "7.1.1",
        "mongoose": "^9.4.1",
        "reflect-metadata": "0.2.2",
        "socket.io": "^4.8.3",
        "swagger-jsdoc": "6.2.8",
        "swagger-ui-express": "5.0.1",
        "typedi": "0.10.0"
    },
    "devDependencies": {
        "@types/body-parser": "1.19.6",
        "@types/chai": "5.2.3",
        "@types/cookie-parser": "1.4.10",
        "@types/cors": "2.8.19",
        "@types/express": "5.0.3",
        "@types/mocha": "10.0.10",
        "@types/node": "25.5.2",
        "@types/node-uuid": "0.0.32",
        "@types/semver": "^7.7.1",
        "@types/sinon": "21.0.1",
        "@types/supertest": "2.0.12",
        "@types/swagger-jsdoc": "6.0.4",
        "@types/swagger-ui-express": "4.1.8",
        "@types/ws": "^8.18.1",
        "chai": "6.2.2",
        "cross-env": "10.1.0",
        "eslint": "^9.39.2",
        "mocha": "^11.7.5",
        "mongodb-memory-server": "^11.0.1",
        "nodemon": "3.1.14",
        "nyc": "18.0.0",
        "prettier": "3.8.1",
        "rimraf": "6.1.3",
        "sinon": "21.0.3",
        "source-map-support": "^0.5.21",
        "supertest": "^7.2.2",
        "ts-node": "10.9.2",
        "tsconfig-paths": "4.2.0",
        "typescript": "~5.9.2",
        "typescript-eslint": "8.50.1"
    }
}
